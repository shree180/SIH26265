# Copy to .env at the repository root (or backend/.env) and adjust.
# Never commit a real .env. All values below are safe development defaults.

APP_ENV=development
# Unset DATABASE_URL to use the bundled SQLite demo database at
# backend/var/fdr_sentinel.db. Production target is PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://fdr_user:change-me@localhost:5432/fdr_sentinel
# Relative sqlite:/// paths resolve from the process working directory.

# Cookies and sessions
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Private document storage (outside any public/static directory).
# Unset UPLOAD_DIR to use backend/var/private_uploads.
MAX_UPLOAD_BYTES=5242880

# "manual" = no bank integration (default). "simulated" = clearly labelled
# demo adapter. Neither proves authenticity; there is no production adapter.
BANK_VERIFICATION_MODE=manual

# Maturity alerting
BUSINESS_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
SCAN_ON_STARTUP=true
MATURITY_SCAN_HOUR_UTC=2
MATURITY_THRESHOLDS=30,15,7
EXPIRY_GRACE_DAYS=90

# Operational SLAs used by priority scoring
REVIEW_SLA_HOURS=48
APPROVAL_SLA_HOURS=48

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Development-only password used by the synthetic seed script.
DEMO_PASSWORD=Sentinel#2026
